{
  "name": "@reposell/sell",
  "version": "0.2.2",
  "description": "Vue sell page template for RepoSell — builds to a single self-contained HTML",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./template": "./dist-sell/index.html",
    "./styles.css": "./styles.css",
    "./scripts.js": "./scripts.js"
  },
  "files": [
    "dist",
    "dist-sell",
    "styles.css",
    "scripts.js",
    "storefront.json"
  ],
  "scripts": {
    "build:vue": "vite build",
    "build:ts": "tsc",
    "build": "npm run build:vue && npm run build:ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "reposell",
    "sell-page",
    "storefront",
    "template"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EnzoVezzaro/reposell-sell.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0"
  }
}
